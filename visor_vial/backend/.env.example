# Copia este archivo a ".env" y completa los valores reales (nunca subas ".env" a git)

# Clave secreta de Django (genera una nueva para producción)
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Cadena de conexión a la base de datos Postgres/PostGIS de Supabase
# Se obtiene en: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Formato: postgresql://postgres:[TU-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.lqwvnkhtcfiswmnikslr.supabase.co:5432/postgres

# Datos del proyecto Supabase (los mismos que usa el frontend)
SUPABASE_URL=https://lqwvnkhtcfiswmnikslr.supabase.co
SUPABASE_ANON_KEY=change-me

# Origen del frontend permitido para CORS
FRONTEND_URL=http://localhost:5173
